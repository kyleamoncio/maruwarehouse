WAREHOUSE_PORTAL_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_ORIGINAL_DEPLOYMENT_ID/exec
WAREHOUSE_PORTAL_V2_URL=https://script.google.com/macros/s/YOUR_V2_DEPLOYMENT_ID/exec
WAREHOUSE_PORTAL_API_TOKEN=change-this-to-a-long-random-secret
# Optional when V2 uses a different token; otherwise the original token is reused.
WAREHOUSE_PORTAL_V2_API_TOKEN=
# Required for PO/SI/DR sign-in. Use: node scripts/hash-password.js "password"
WAREHOUSE_PORTAL_USERS_JSON=[{"username":"warehouse","displayName":"Warehouse Staff","role":"operator","passwordHash":"pbkdf2$REPLACE_WITH_GENERATED_HASH"}]
# At least 32 random characters. Never reuse the Apps Script token.
WAREHOUSE_PORTAL_SESSION_SECRET=replace-with-a-separate-long-random-secret
# Stable HMAC secret for non-expiring private PDF links. Keep this value across deployments/rotations.
# If omitted, the session secret above is used only when it is at least 32 characters.
WAREHOUSE_PORTAL_DOCUMENT_LINK_SECRET=replace-with-another-stable-long-random-secret
# Canonical Portal origin used in links persisted to SUMMARY.
WAREHOUSE_PORTAL_PUBLIC_URL=https://maruwarehouse.vercel.app
# Private Vercel Blob store credentials (automatically added when Blob is connected).
BLOB_READ_WRITE_TOKEN=
# Optional with OIDC-based Blob access.
BLOB_STORE_ID=
ALLOWED_ORIGIN=https://maruwarehouse.vercel.app
